{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xfina-data",
  "compatibility_date": "2026-10-02",

  // An assets-only Worker: there is no script, so every request is served
  // straight from the edge with no Worker invocation and no per-request cost.
  // The Vue app in site/ builds ./site/dist: static pages from the data
  // branch's site-data.json, with the data branch's v1/ copied in.
  "assets": {
    "directory": "./site/dist",
    "not_found_handling": "404-page"
  },

  "routes": [
    { "pattern": "data.xfina.dev", "custom_domain": true }
  ]
}
